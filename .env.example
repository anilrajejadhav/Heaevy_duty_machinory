# Application
APP_NAME=Enterprise RAG API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Local storage paths, relative to the project root
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
SAMPLE_DOCS_DIR=data/sample_docs
MODELS_DIR=models
FAISS_INDEX_PATH=models/faiss.index
FAISS_METADATA_PATH=models/faiss_metadata.json

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Embedding and retrieval
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TOP_K=10
RERANK_TOP_K=5

# Generation
LLM_PROVIDER=huggingface
LLM_MODEL_NAME=google/flan-t5-base
LLM_MAX_NEW_TOKENS=256
LLM_TEMPERATURE=0.0

# Optional external provider keys; leave empty unless the provider is enabled.
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
OLLAMA_BASE_URL=http://localhost:11434
