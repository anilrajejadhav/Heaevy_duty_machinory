# Copy this file to .env only if you want to override these defaults.
APP_NAME=TVH Findability Demo
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Use 0 to read every PDF page. For a quick presentation demo use 30.
MAX_PAGES_PER_PDF=0
SEARCH_RESULT_LIMIT=10

# Local files created by the application
DATA_DIR=data
INDEX_PATH=models/catalog_index.json
RECOMMENDATIONS_PATH=models/recommendations.json
